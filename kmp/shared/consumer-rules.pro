# ==============================================================================
# Finsim Shared Library - Consumer ProGuard / R8 Rules
# ==============================================================================
# These rules are automatically packaged into the shared library AAR and applied
# to any consuming Android application (such as :composeApp).
#
# DESIGN PHILOSOPHY:
# Minimal, targeted preservation of serialization reflection and bytecode seams.
# We explicitly AVOID overly broad package wildcards (-keep class com.finsim.** { *; })
# so R8 can aggressively shrink, inline, and obfuscate domain logic.

# ------------------------------------------------------------------------------
# 1. kotlinx.serialization Targeted Member Preservation
# ------------------------------------------------------------------------------
# Preserve the Companion object field on @Serializable classes so companion lookups succeed
-keepclassmembers class * {
    *** Companion;
}

# Preserve the serializer() method on companion objects
-keepclasseswithmembers class * {
    kotlinx.serialization.KSerializer serializer(...);
}

# Preserve the generated GeneratedSerializer and KSerializer INSTANCE singletons
-keepclassmembers class * implements kotlinx.serialization.internal.GeneratedSerializer {
    public static final ** INSTANCE;
}
-keepclassmembers class * implements kotlinx.serialization.KSerializer {
    public static final ** INSTANCE;
}

# Preserve the synthetic constructor used by kotlinx.serialization during deserialization
-keepclassmembers class * {
    <init>(int, ..., kotlinx.serialization.internal.SerializationConstructorMarker);
}

# Preserve static write$Self helper generated by the Kotlin serialization plugin
-keepclassmembers class * {
    public static final void write$Self$*(***);
}

# Preserve enum entries and standard reflection methods for @Serializable enums
# (e.g. Currency, RegulatoryFramework) so JSON string discriminator values match
-keepclassmembers @kotlinx.serialization.Serializable enum * {
    public static **[] values();
    public static ** valueOf(java.lang.String);
    <fields>;
}

# ------------------------------------------------------------------------------
# 2. AndroidX @Keep Annotation Support
# ------------------------------------------------------------------------------
# Honor @Keep annotations for any targeted class or member explicitly marked
-keep @androidx.annotation.Keep class * { *; }
-keepclassmembers class * {
    @androidx.annotation.Keep *;
}

# ------------------------------------------------------------------------------
# 3. Suppress Benign Warnings
# ------------------------------------------------------------------------------
# Serialization core uses ClassValue references on Java 9+, absent on older Android runtimes
-dontwarn kotlinx.serialization.internal.ClassValueReferences
