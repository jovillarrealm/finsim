{
  "name": "finsim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite preview --host 127.0.0.1 --port 5173 --outDir kmp/composeApp/build/dist/wasmJs/productionExecutable",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 kmp/composeApp/browser-tests/*.test.cjs",
    "test:verification": "node --test scripts/verify-financial.test.mjs",
    "verify:financial": "node scripts/verify-financial.mjs",
    "test:kmp": "gradle -p kmp :shared:jvmTest :composeApp:testAndroidHostTest",
    "build": "gradle -p kmp :composeApp:wasmJsBrowserDistribution",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "apache-arrow": "^21.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
